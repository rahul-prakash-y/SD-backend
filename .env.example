# ─── Server ────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/eduportal

# ─── JWT Auth ──────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────
CLIENT_URL=http://localhost:5173
